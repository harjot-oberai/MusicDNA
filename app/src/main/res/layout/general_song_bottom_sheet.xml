<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="10dp"
    android:paddingTop="10dp">

    <ImageView
        android:id="@+id/general_song_bottom_sheet_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginStart="20dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/general_song_bottom_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginTop="5dp"
        android:layout_toEndOf="@id/general_song_bottom_sheet_image"
        android:maxLines="1"
        android:text="@string/title"
        android:textColor="#000"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/general_song_bottom_sheet_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/general_song_bottom_sheet_title"
        android:layout_marginStart="13dp"
        android:layout_marginTop="2dp"
        android:layout_toEndOf="@id/general_song_bottom_sheet_image"
        android:text="@string/artist"
        android:textColor="#444"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/general_song_bottom_sheet_play_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/general_song_bottom_sheet_image"
        android:layout_marginTop="5dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:src="@drawable/bs_play_2"
            android:tint="#494949" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="center_vertical"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="@string/play"
            android:textAlignment="gravity"
            android:textColor="#111111"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/general_song_bottom_sheet_play_next_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/general_song_bottom_sheet_play_wrapper"
        android:layout_marginTop="5dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:padding="10dp"
            android:src="@drawable/bs_play_2"
            android:tint="#494949" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="@string/play_next"
            android:textColor="#111111"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/general_song_bottom_sheet_add_to_queue_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/general_song_bottom_sheet_play_next_wrapper"
        android:layout_marginTop="5dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:paddingEnd="11dp"
            android:paddingStart="9dp"
            android:src="@drawable/ic_add_to_queue"
            android:tint="#494949" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="@string/add_to_queue"
            android:textColor="#111111"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/general_song_bottom_sheet_add_to_playlist_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/general_song_bottom_sheet_add_to_queue_wrapper"
        android:layout_marginTop="5dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:paddingEnd="6dp"
            android:paddingStart="9dp"
            android:src="@drawable/ic_playlist_add_black_48dp"
            android:tint="#494949" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="@string/add_to_playlist"
            android:textColor="#111111"
            android:textSize="18sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/general_song_bottom_sheet_add_to_fav_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/general_song_bottom_sheet_add_to_playlist_wrapper"
        android:layout_marginTop="5dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:padding="10dp"
            android:src="@drawable/bs_fav_2"
            android:tint="#494949" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            android:text="@string/add_to_favourites"
            android:textColor="#111111"
            android:textSize="18sp" />

    </LinearLayout>

</RelativeLayout>